{
  "id":              "tools.xprs.movies",
  "version":         "0.1.4",
  "kind":            "app",
  "title":           "Movies",
  "description":     "Play the videos stored on this device.",
  "summary":         "Play local video files in formats like mp4 and mkv and webm. Subtitles in SRT format are supported. Playback uses the device's own media engine.",
  "icon":            "media/icons/movies.svg",
  "tags":            ["video", "movie", "media", "player"],
  "entry_ui":        "screens/home.ui.json",
  "tick_interval_ms": 0,
  "permissions":     ["storage"],
  "platforms":       ["linux", "windows", "macos", "android", "ios"],
  "hardware":        ["intel", "arm"],
  "provides": {
    "functionalities": [],
    "file_handlers": [
      {
        "extensions": ["mp4", "m4v", "mkv", "webm", "mov", "avi", "flv", "wmv", "mpeg", "mpg", "ogv", "ts", "mts", "m2ts", "3gp"],
        "mime":       ["video/*"],
        "title":      "Play",
        "modes":      ["view"]
      },
      {
        "extensions": ["srt", "vtt", "ass", "ssa", "sub"],
        "mime":       ["application/x-subrip", "text/vtt"],
        "title":      "Open subtitle",
        "modes":      ["view"]
      }
    ]
  },
  "requires": {
    "hal":            ["log", "kv", "msg"],
    "functionalities": ["media.video"],
    "events":         [],
    "libraries":      [],
    "variables":      []
  }
}
