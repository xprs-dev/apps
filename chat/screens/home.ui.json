[
  {
    "$": "screen",
    "name": "@screen.chat",
    "icon": "campaign",
    "children": [
      {
        "$": "group",
        "name": "rooms",
        "$type": "rooms"
      }
    ]
  },
  {
    "$": "screen",
    "name": "@screen.start",
    "menu": true,
    "popup": true,
    "icon": "person_add",
    "tip": "@screen.start_tip",
    "children": [
      {
        "$": "action",
        "name": "rooms_newchat",
        "label": "@action.newchat",
        "icon": "person_add",
        "tip": "@action.newchat_tip"
      }
    ]
  },
  {
    "$": "screen",
    "name": "@screen.newgroup",
    "menu": true,
    "popup": true,
    "icon": "group_add",
    "tip": "@screen.newgroup_tip",
    "children": [
      {
        "$": "action",
        "name": "rooms_newgroup",
        "label": "@action.newgroup",
        "icon": "group_add",
        "tip": "@action.newgroup_tip"
      }
    ]
  },
  {
    "$": "screen",
    "name": "@screen.find",
    "menu": true,
    "popup": true,
    "appbar": true,
    "appbar_only": true,
    "icon": "search",
    "tip": "@screen.find_tip",
    "children": [
      {
        "$": "action",
        "name": "rooms_search",
        "label": "@action.search",
        "icon": "search",
        "tip": "@action.search_tip"
      }
    ]
  },
  {
    "$": "screen",
    "name": "@screen.search",
    "hidden": true,
    "toolbar": true,
    "search": true,
    "tabs": "People,Messages,Groups",
    "tip": "@screen.search_tip",
    "children": [
      {
        "$": "field",
        "name": "searchall",
        "$type": "people",
        "empty": "@field.searchall_empty",
        "tip": "@field.searchall_tip"
      }
    ]
  },
  {
    "$": "screen",
    "name": "@screen.newchat",
    "hidden": true,
    "toolbar": true,
    "search": true,
    "tip": "@screen.newchat_tip",
    "children": [
      {
        "$": "field",
        "name": "finduser",
        "$type": "people",
        "empty": "@field.finduser_empty",
        "tip": "@field.finduser_tip"
      }
    ]
  },
  {
    "$": "screen",
    "name": "@screen.group",
    "hidden": true,
    "children": [
      { "$": "field", "name": "members", "$type": "members" }
    ]
  },
  {
    "$": "screen",
    "name": "@screen.invite",
    "hidden": true,
    "toolbar": true,
    "search": true,
    "tip": "@screen.invite_tip",
    "children": [
      {
        "$": "field",
        "name": "inviteuser",
        "$type": "people",
        "empty": "@field.inviteuser_empty",
        "tip": "@field.inviteuser_tip"
      }
    ]
  },
  {
    "$": "screen",
    "name": "@screen.archived",
    "hidden": true,
    "toolbar": true,
    "tip": "@screen.archived_tip",
    "children": [
      {
        "$": "field",
        "name": "archived",
        "$type": "people",
        "empty": "@field.archived_empty",
        "tip": "@field.archived_tip"
      }
    ]
  },
  {
    "$": "screen",
    "name": "@screen.nearby",
    "icon": "radar",
    "tip": "@screen.nearby_tip",
    "open_wapp": "mesh",
    "children": [],
    "menu": true
  },
  {
    "$": "screen",
    "name": "@screen.settings",
    "menu": true,
    "icon": "settings",
    "tip": "@screen.settings_tip",
    "children": [
      {
        "$": "group",
        "name": "channels",
        "tip": "@group.channels_tip",
        "children": [
          {
            "$": "field",
            "name": "chan_local",
            "$type": "bool",
            "label": "@field.chan_local",
            "default": true,
            "apply": "chan_apply",
            "tip": "@field.chan_local_tip"
          }
        ]
      }
    ]
  }
]
