[
  {
    "$": "screen",
    "name": "@screen.ai",
    "children": [
      {
        "$": "group",
        "name": "@group.chat",
        "children": [
          {"$": "field", "name": "editing", "$type": "string", "label": "@field.editing", "readonly": true},
          {"$": "field", "name": "ai", "$type": "chat", "label": "@field.ai", "hint": "@field.ai_hint"}
        ]
      },
      {
        "$": "group",
        "name": "@group.changes",
        "children": [
          {"$": "field", "name": "changes", "$type": "string", "label": "@field.changes", "multiline": true, "readonly": true},
          {"$": "action", "name": "apply", "label": "@action.apply", "style": "primary", "icon": "check"},
          {"$": "action", "name": "discard", "label": "@action.discard", "icon": "close"},
          {"$": "action", "name": "undo", "label": "@action.undo", "icon": "undo"},
          {"$": "action", "name": "new_chat", "label": "@action.new_chat", "icon": "refresh"}
        ]
      }
    ]
  },
  {
    "$": "screen",
    "name": "@screen.settings",
    "children": [
      {
        "$": "group",
        "name": "@group.ai",
        "children": [
          {"$": "field", "name": "ai_provider", "$type": "enum", "label": "@field.provider", "default": "claude", "children": [
            {"$": "option", "name": "claude", "label": "Claude"},
            {"$": "option", "name": "openai", "label": "Codex / OpenAI"},
            {"$": "option", "name": "opencode", "label": "OpenCode Zen"},
            {"$": "option", "name": "compatible", "label": "@option.compatible"}
          ]},
          {"$": "field", "name": "ai_model", "$type": "string", "label": "@field.model", "hint": "@field.model_hint"},
          {"$": "field", "name": "ai_base_url", "$type": "string", "label": "@field.base_url", "hint": "@field.base_url_hint"},
          {"$": "field", "name": "ai_key", "$type": "secret", "label": "@field.key", "hint": "@field.key_hint"},
          {"$": "action", "name": "save_settings", "label": "@action.save", "style": "primary", "icon": "save"},
          {"$": "action", "name": "forget_key", "label": "@action.forget_key", "icon": "delete", "confirm": true, "confirm-label": "@action.forget_key_confirm"}
        ]
      }
    ]
  }
]
