[
  {
    "$": "screen",
    "name": "Check-in",
    "icon": "verified",
    "children": [
      {
        "$": "field",
        "name": "lb_stats",
        "$type": "stats"
      },
      {
        "$": "field",
        "name": "log",
        "$type": "people",
        "empty_title": "No check-ins yet",
        "empty": "Check in at a station to start your log and collect its badge."
      }
    ],
    "tip": "Walk up to a station: those heard over Bluetooth in the last 10 minutes are in reach. Tap Check in to collect its badge."
  },
  {
    "$": "screen",
    "name": "Settings",
    "icon": "settings",
    "menu": true,
    "tip": "Let people near you check in here. Your station answers while XPRS runs; to answer with it closed, long-press Check-in on the home screen and turn on Run in background.",
    "children": [
      {
        "$": "group",
        "name": "Location",
        "children": [
          {
            "$": "field",
            "name": "st_info",
            "$type": "details",
            "empty": ""
          }
        ]
      },
      {
        "$": "action",
        "name": "share_location",
        "label": "Share my location",
        "icon": "map",
        "open": "host:position"
      },
      {
        "$": "group",
        "name": "Check-ins",
        "children": [
          {
            "$": "field",
            "name": "bot_on",
            "$type": "bool",
            "label": "Give check-ins",
            "default": false,
            "tip": "People nearby can check in here.",
            "apply": "set_bot"
          },
          {
            "$": "field",
            "name": "local_only",
            "$type": "bool",
            "label": "In person only",
            "default": true,
            "tip": "Off: anyone in LoRa range can check in.",
            "apply": "set_local"
          }
        ]
      },
      {
        "$": "group",
        "name": "Welcome",
        "children": [
          {
            "$": "field",
            "name": "greeting",
            "$type": "string",
            "label": "Greeting",
            "hint": "Welcome to the hill, 73!",
            "max": 150,
            "tip": "Sent to each visitor.",
            "apply": "save_greeting"
          },
          {
            "$": "field",
            "name": "intro",
            "$type": "string",
            "label": "About this station",
            "hint": "Hilltop shack, ring the bell",
            "max": 100,
            "tip": "Shown with your pin on the map.",
            "apply": "save_intro"
          }
        ]
      },
      {
        "$": "group",
        "name": "Badge",
        "children": [
          {
            "$": "field",
            "name": "badge_pic",
            "$type": "image",
            "label": "",
            "readonly": true,
            "tip": "Visitors collect it when they check in."
          }
        ]
      },
      {
        "$": "action",
        "name": "pick_badge",
        "label": "Choose badge",
        "icon": "image"
      },
      {
        "$": "group",
        "name": "Events",
        "children": [
          {
            "$": "field",
            "name": "ev_info",
            "$type": "details",
            "empty": ""
          }
        ]
      },
      {
        "$": "action",
        "name": "new_event",
        "label": "New event",
        "icon": "campaign"
      },
      {
        "$": "action",
        "name": "guests_open",
        "label": "Visitors",
        "icon": "people"
      }
    ]
  },
  {
    "$": "screen",
    "name": "Visitors",
    "icon": "people",
    "tip": "Your events and the people who checked in here.",
    "children": [
      {
        "$": "field",
        "name": "guests",
        "$type": "people",
        "empty_title": "No visitors yet",
        "empty": "People who check in here are listed here."
      }
    ],
    "hidden": true
  },
  {
    "$": "screen",
    "name": "New event",
    "icon": "schedule",
    "hidden": true,
    "tip": "Starts now. Check-ins during it get its name and badge.",
    "children": [
      {
        "$": "field",
        "name": "ev_title",
        "$type": "string",
        "label": "Name",
        "hint": "Field Day 2026",
        "max": 30
      },
      {
        "$": "field",
        "name": "ev_desc",
        "$type": "string",
        "label": "Description",
        "hint": "On the hill all weekend",
        "max": 40
      },
      {
        "$": "field",
        "name": "ev_len",
        "$type": "enum",
        "label": "Length",
        "default": "day",
        "children": [
          {
            "$": "option",
            "name": "day",
            "label": "One day"
          },
          {
            "$": "option",
            "name": "week",
            "label": "One week"
          },
          {
            "$": "option",
            "name": "month",
            "label": "One month"
          }
        ]
      },
      {
        "$": "group",
        "name": "Badge",
        "children": [
          {
            "$": "field",
            "name": "ev_pic",
            "$type": "image",
            "label": "",
            "readonly": true,
            "tip": "Optional. Without one, your station's badge is used."
          }
        ]
      },
      {
        "$": "action",
        "name": "pick_event_badge",
        "label": "Choose badge",
        "icon": "image"
      },
      {
        "$": "action",
        "name": "publish_event",
        "label": "Announce",
        "style": "primary",
        "icon": "campaign"
      }
    ]
  },
  {
    "$": "screen",
    "name": "Score detail",
    "icon": "insights",
    "hidden": true,
    "children": [
      {
        "$": "field",
        "name": "detail",
        "$type": "people",
        "empty": ""
      }
    ]
  },
  {
    "$": "screen",
    "name": "Entry",
    "icon": "check",
    "hidden": true,
    "children": [
      {
        "$": "field",
        "name": "e_badge",
        "$type": "image",
        "label": "",
        "readonly": true
      },
      {
        "$": "field",
        "name": "e_info",
        "$type": "details",
        "empty": ""
      },
      {
        "$": "action",
        "name": "remove_entry",
        "label": "Remove",
        "icon": "delete",
        "style": "danger",
        "confirm": true,
        "confirm-label": "Remove this check-in?",
        "confirm-text": "It leaves your log, map and stats."
      }
    ]
  }
]
