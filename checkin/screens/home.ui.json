[
  {
    "$": "screen",
    "name": "Check-in",
    "icon": "verified",
    "children": [
      {
        "$": "field",
        "name": "lb_stats",
        "$type": "stats"
      },
      {
        "$": "field",
        "name": "log_tags",
        "$type": "chips"
      },
      {
        "$": "field",
        "name": "log",
        "$type": "people",
        "empty_title": "No places yet",
        "empty": "Check in at a station to start: it becomes a place, and the time you spend there is counted."
      },
      {
        "$": "action",
        "name": "tags_open",
        "label": "Tags",
        "icon": "label"
      }
    ],
    "tip": "Walk up to a station and check in. After the first time it happens by itself, and the time you spend in its Bluetooth range is counted. Tags sort your places.",
    "search": true
  },
  {
    "$": "screen",
    "name": "Settings",
    "icon": "settings",
    "menu": true,
    "tip": "A station you own gives check-ins by itself: this device, a board on a roof or a server, set up from here wherever it is. Each change is sent to that station.",
    "children": [
      {
        "$": "group",
        "name": "Location",
        "children": [
          {
            "$": "field",
            "name": "st_info",
            "$type": "details",
            "empty": ""
          }
        ]
      },
      {
        "$": "action",
        "name": "share_location",
        "label": "Share my location",
        "icon": "map",
        "open": "host:position"
      },
      {
        "$": "action",
        "name": "stations_open",
        "label": "Another station",
        "icon": "cell_tower",
        "tip": "Set up check-ins on another station you own."
      },
      {
        "$": "group",
        "name": "Check-ins",
        "children": [
          {
            "$": "field",
            "name": "bot_on",
            "$type": "bool",
            "label": "Give check-ins",
            "default": false,
            "tip": "People nearby can check in here.",
            "apply": "set_bot"
          },
          {
            "$": "field",
            "name": "local_only",
            "$type": "bool",
            "label": "In person only",
            "default": true,
            "tip": "Off: anyone in LoRa range can check in.",
            "apply": "set_local"
          }
        ]
      },
      {
        "$": "group",
        "name": "Welcome",
        "children": [
          {
            "$": "field",
            "name": "greeting",
            "$type": "string",
            "label": "Welcome",
            "hint": "Welcome to the hill, 73!",
            "max": 100,
            "tip": "Shown with the station on the map, and sent to each visitor. Sent to the station when you leave this screen.",
            "apply": "save_greeting"
          },
          {
            "$": "field",
            "name": "place_type",
            "$type": "enum",
            "label": "Kind of place",
            "default": "none",
            "tip": "Visitors see it, and their log sorts your station under it.",
            "apply": "save_type",
            "children": [
              {
                "$": "option",
                "name": "none",
                "label": "Not set"
              },
              {
                "$": "option",
                "name": "airport",
                "label": "Airport"
              },
              {
                "$": "option",
                "name": "bakery",
                "label": "Bakery"
              },
              {
