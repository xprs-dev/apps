[
  {
    "$": "screen",
    "name": "Map",
    "icon": "map",
    "toolbar": true,
    "tip": "White: your check-ins. Green: stations. Amber: events.",
    "children": [
      {
        "$": "group",
        "name": "checkin-map",
        "$type": "map",
        "tile-url": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
        "tile-style": "dark",
        "default-lat": 38.7223,
        "default-lon": -9.1393,
        "default-zoom": 3,
        "min-zoom": 2,
        "max-zoom": 18,
        "radius": false,
        "chat": false,
        "search": false
      },
      {
        "$": "action",
        "name": "fit_map",
        "label": "Show all",
        "icon": "map"
      },
      {
        "$": "action",
        "name": "save_area",
        "label": "Save offline",
        "icon": "download"
      }
    ]
  },
  {
    "$": "screen",
    "name": "Nearby",
    "icon": "radar",
    "tip": "Stations in reach right now.",
    "children": [
      {
        "$": "field",
        "name": "nearby",
        "$type": "people",
        "empty_title": "No stations in reach",
        "empty": "Walk up to a station to see it here."
      },
      {
        "$": "field",
        "name": "chase_regional",
        "$type": "bool",
        "label": "Use LoRa too",
        "default": false,
        "tip": "Reach stations farther away. Never over the internet.",
        "apply": "set_chase"
      },
      {
        "$": "action",
        "name": "nearby_refresh",
        "label": "Refresh",
        "icon": "refresh"
      }
    ],
    "toolbar": true
  },
  {
    "$": "screen",
    "name": "Logbook",
    "icon": "history",
    "children": [
      {
        "$": "field",
        "name": "lb_stats",
        "$type": "stats"
      },
      {
        "$": "field",
        "name": "log",
        "$type": "people",
        "empty_title": "No check-ins yet",
        "empty": "Check in at a station to start your log."
      }
    ]
  },
  {
    "$": "screen",
    "name": "Badges",
    "icon": "star",
    "children": [
      {
        "$": "field",
        "name": "badges",
        "$type": "people",
        "empty_title": "No badges yet",
        "empty": "Each check-in earns the station's badge."
      }
    ]
  },
  {
    "$": "screen",
    "name": "Explore",
    "icon": "public",
    "tip": "Stations and events, nearest first.",
    "children": [
      {
        "$": "field",
        "name": "events",
        "$type": "people",
        "empty_title": "Nothing to explore yet",
        "empty": "Stations and events appear here once heard."
      },
      {
        "$": "action",
        "name": "events_refresh",
        "label": "Refresh",
        "icon": "refresh"
      }
    ],
    "toolbar": true
  },
  {
    "$": "screen",
    "name": "My station",
    "icon": "cell_tower",
    "tip": "To answer with the app closed, long-press Check-in on the home screen and turn on Run in background.",
    "children": [
      {
        "$": "group",
        "name": "Check-ins",
        "children": [
          {
            "$": "field",
            "name": "bot_on",
            "$type": "bool",
            "label": "Give check-ins",
            "default": false,
            "tip": "Let people nearby check in here.",
            "apply": "set_bot"
          },
          {
            "$": "field",
            "name": "local_only",
            "$type": "bool",
            "label": "In person only",
            "default": true,
            "tip": "Off: anyone in LoRa range can check in.",
            "apply": "set_local"
          },
          {
            "$": "field",
            "name": "st_info",
            "$type": "details",
            "empty": ""
          }
        ]
      },
      {
        "$": "group",
        "name": "Welcome",
        "children": [
          {
            "$": "field",
            "name": "greeting",
            "$type": "string",
            "label": "Greeting",
            "hint": "Welcome to the hill, 73!",
            "max": 150,
            "tip": "Sent to each visitor."
          },
          {
            "$": "field",
            "name": "intro",
            "$type": "string",
            "label": "About this station",
            "hint": "Hilltop shack, ring the bell",
            "max": 100,
            "tip": "Shown with your pin on the map."
          }
        ]
      },
      {
        "$": "action",
        "name": "save_texts",
        "label": "Save",
        "icon": "check"
      },
      {
        "$": "group",
        "name": "Badge",
        "children": [
          {
            "$": "field",
            "name": "badge_pic",
            "$type": "image",
            "label": "",
            "readonly": true,
            "tip": "Visitors collect it when they check in."
          }
        ]
      },
      {
        "$": "action",
        "name": "pick_badge",
        "label": "Choose badge",
        "icon": "image"
      },
      {
        "$": "group",
        "name": "Events",
        "children": [
          {
            "$": "field",
            "name": "ev_info",
            "$type": "details",
            "empty": ""
          }
        ]
      },
      {
        "$": "action",
        "name": "new_event",
        "label": "New event",
        "icon": "campaign"
      }
    ]
  },
  {
    "$": "screen",
    "name": "Guestbook",
    "icon": "people",
    "toolbar": true,
    "tip": "Your events and visitors.",
    "children": [
      {
        "$": "field",
        "name": "guests",
        "$type": "people",
        "empty_title": "No visitors yet",
        "empty": "People who check in here are listed here."
      }
    ]
  },
  {
    "$": "screen",
    "name": "New event",
    "icon": "schedule",
    "hidden": true,
    "tip": "Starts now. Check-ins during it get its name and badge.",
    "children": [
      {
        "$": "field",
        "name": "ev_title",
        "$type": "string",
        "label": "Name",
        "hint": "Field Day 2026",
        "max": 30
      },
      {
        "$": "field",
        "name": "ev_desc",
        "$type": "string",
        "label": "Description",
        "hint": "On the hill all weekend",
        "max": 40
      },
      {
        "$": "field",
        "name": "ev_len",
        "$type": "enum",
        "label": "Length",
        "default": "day",
        "children": [
          {
            "$": "option",
            "name": "day",
            "label": "One day"
          },
          {
            "$": "option",
            "name": "week",
            "label": "One week"
          },
          {
            "$": "option",
            "name": "month",
            "label": "One month"
          }
        ]
      },
      {
        "$": "group",
        "name": "Badge",
        "children": [
          {
            "$": "field",
            "name": "ev_pic",
            "$type": "image",
            "label": "",
            "readonly": true,
            "tip": "Optional. Without one, your station's badge is used."
          }
        ]
      },
      {
        "$": "action",
        "name": "pick_event_badge",
        "label": "Choose badge",
        "icon": "image"
      },
      {
        "$": "action",
        "name": "publish_event",
        "label": "Announce",
        "style": "primary",
        "icon": "campaign"
      }
    ]
  },
  {
    "$": "screen",
    "name": "Entry",
    "icon": "check",
    "hidden": true,
    "children": [
      {
        "$": "field",
        "name": "e_info",
        "$type": "details",
        "empty": ""
      },
      {
        "$": "action",
        "name": "remove_entry",
        "label": "Remove",
        "icon": "delete",
        "style": "danger",
        "confirm": true,
        "confirm-label": "Remove this check-in?",
        "confirm-text": "It leaves your log, map and stats."
      }
    ]
  }
]
