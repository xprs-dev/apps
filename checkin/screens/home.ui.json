              }
            ]
          }
        ]
      },
      {
        "$": "group",
        "name": "Badge",
        "children": [
          {
            "$": "field",
            "name": "badge_pic",
            "$type": "image",
            "label": "",
            "readonly": true,
            "tip": "Visitors collect it when they check in."
          }
        ]
      },
      {
        "$": "action",
        "name": "pick_badge",
        "label": "Choose badge",
        "icon": "image"
      },
      {
        "$": "group",
        "name": "Events",
        "children": [
          {
            "$": "field",
            "name": "ev_info",
            "$type": "details",
            "empty": ""
          }
        ]
      },
      {
        "$": "action",
        "name": "new_event",
        "label": "New event",
        "icon": "campaign"
      },
      {
        "$": "action",
        "name": "guests_open",
        "label": "Visitors",
        "icon": "people"
      }
    ]
  },
  {
    "$": "screen",
    "name": "Stations",
    "icon": "cell_tower",
    "hidden": true,
    "children": [
      {
        "$": "field",
        "name": "stations",
        "$type": "people",
        "layout": "list",
        "empty": "No stations of yours are known yet."
      }
    ]
  },
  {
    "$": "screen",
    "name": "Visitors",
    "icon": "people",
    "tip": "Your events and the people who checked in here.",
    "children": [
      {
        "$": "field",
        "name": "guests",
        "$type": "people",
        "empty_title": "No visitors yet",
        "empty": "People who check in here are listed here."
      }
    ],
    "hidden": true
  },
  {
    "$": "screen",
    "name": "New event",
    "icon": "schedule",
    "hidden": true,
    "tip": "Starts now. Check-ins during it get its name and badge.",
    "children": [
      {
        "$": "field",
        "name": "ev_title",
        "$type": "string",
        "label": "Name",
        "hint": "Field Day 2026",
        "max": 30
      },
      {
        "$": "field",
        "name": "ev_desc",
        "$type": "string",
        "label": "Description",
        "hint": "On the hill all weekend",
        "max": 40
      },
      {
        "$": "field",
        "name": "ev_len",
        "$type": "enum",
        "label": "Length",
        "default": "day",
        "children": [
          {
            "$": "option",
            "name": "day",
            "label": "One day"
          },
          {
            "$": "option",
            "name": "week",
            "label": "One week"
          },
          {
            "$": "option",
            "name": "month",
            "label": "One month"
          }
        ]
      },
      {
        "$": "group",
        "name": "Badge",
        "children": [
          {
            "$": "field",
            "name": "ev_pic",
            "$type": "image",
            "label": "",
            "readonly": true,
            "tip": "Optional. Without one, your station's badge is used."
          }
        ]
      },
      {
        "$": "action",
        "name": "pick_event_badge",
        "label": "Choose badge",
        "icon": "image"
      },
      {
        "$": "action",
        "name": "publish_event",
        "label": "Announce",
        "style": "primary",
        "icon": "campaign"
      }
    ]
  },
  {
    "$": "screen",
    "name": "Score detail",
    "icon": "insights",
    "hidden": true,
    "children": [
      {
        "$": "field",
        "name": "detail",
        "$type": "people",
        "empty": ""
      }
    ]
  },
  {
    "$": "screen",
    "name": "Entry",
    "icon": "check",
    "hidden": true,
    "children": [
      {
        "$": "field",
        "name": "e_badge",
        "$type": "image",
        "label": "",
        "readonly": true
      },
      {
        "$": "field",
        "name": "e_place",
        "$type": "place",
        "zoom": 15
      },
      {
        "$": "field",
        "name": "e_info",
        "$type": "details",
        "layout": "rows",
        "empty": ""
      },
      {
        "$": "action",
        "name": "entry_event",
        "label": "About the event",
        "icon": "campaign"
      },
      {
        "$": "action",
        "name": "entry_station",
        "label": "About the station",
        "icon": "cell_tower"
      },
      {
        "$": "field",
        "name": "e_proof",
        "$type": "details",
        "empty": ""
      },
      {
        "$": "action",
        "name": "remove_entry",
        "label": "Remove",
        "icon": "delete",
        "style": "danger",
        "confirm": true,
        "confirm-label": "Remove this check-in?",
        "confirm-text": "It leaves your log and stats."
      }
    ]
  },
  {
    "$": "screen",
    "name": "About",
    "icon": "info",
    "hidden": true,
    "children": [
      {
        "$": "field",
        "name": "a_badge",
        "$type": "image",
        "label": "",
        "readonly": true
      },
      {
        "$": "field",
        "name": "a_place",
        "$type": "place",
        "zoom": 15
      },
      {
        "$": "field",
        "name": "a_info",
        "$type": "details",
        "layout": "rows",
        "empty": ""
      },
      {
        "$": "field",
        "name": "a_auto",
        "$type": "bool",
        "label": "Check in automatically",
        "default": true,
        "tip": "Once a day, when this station is in Bluetooth reach.",
        "apply": "set_auto"
      },
      {
        "$": "action",
        "name": "about_list",
        "label": "Your check-ins here",
        "icon": "check"
      },
      {
        "$": "action",
        "name": "about_station",
        "label": "About the station",
        "icon": "cell_tower"
      },
      {
        "$": "action",
        "name": "about_visits",
        "label": "Visits",
        "icon": "schedule"
      },
      {
        "$": "action",
        "name": "add_tag",
        "label": "Add a tag",
        "icon": "label"
      },
      {
        "$": "action",
        "name": "remove_tag",
        "label": "Remove a tag",
        "icon": "close"
      }
    ]
  },
  {
    "$": "screen",
    "name": "Tags",
    "icon": "label",
    "hidden": true,
    "tip": "Every tag on your places: the kinds of place stations say they are, the automatic ones and yours.",
    "children": [
      {
        "$": "field",
        "name": "tags_list",
        "$type": "people",
        "empty_title": "No tags yet",
        "empty": "Places get tags as you check in."
      }
    ]
  }
]
