    "$": "action",
    "name": "tile_room_take",
    "label": "Take new people again",
    "icon": "person_add"
   }
  ]
 },
 {
  "$": "screen",
  "name": "Flash",
  "icon": "usb",
  "hidden": true,
  "children": [
   {
    "$": "field",
    "name": "fl_pic",
    "$type": "image",
    "shape": "wide",
    "readonly": true,
    "label": ""
   },
   {
    "$": "field",
    "name": "dev_now",
    "$type": "details",
    "empty": ""
   },
   {
    "$": "field",
    "name": "dev_hub",
    "$type": "stats"
   },
   {
    "$": "action",
    "name": "flash_write",
    "label": "Install XPRS",
    "style": "primary",
    "icon": "download",
    "confirm": true,
    "confirm-label": "Install XPRS on this board?",
    "confirm-text": "Its firmware is replaced and checked. Keep the cable in until it says done."
   },
   {
    "$": "action",
    "name": "flash_cancel",
    "label": "Stop",
    "style": "danger",
    "icon": "stop"
   },
   {
    "$": "field",
    "name": "fl_info",
    "$type": "details",
    "empty": "",
    "layout": "rows"
   },
   {
    "$": "field",
    "name": "fl_adv",
    "$type": "bool",
    "label": "Advanced options",
    "default": false,
    "apply": "fl_adv"
   },
   {
    "$": "group",
    "name": "fl_advanced",
    "children": [
     {
      "$": "action",
      "name": "flash_choose",
      "label": "Choose the board",
      "icon": "list"
     },
     {
      "$": "action",
      "name": "fl_callsign",
      "label": "Choose a callsign",
      "icon": "key"
     },
     {
      "$": "action",
      "name": "fl_callsign_clear",
      "label": "Let the board make one",
      "icon": "close"
     },
     {
      "$": "field",
      "name": "wipe",
      "$type": "bool",
      "label": "Erase its settings",
      "default": false,
      "apply": "fl_wipe",
      "tip": "Off keeps the station's key, owner and WiFi. On makes it a new station."
     },
     {
      "$": "action",
      "name": "flash_identify",
      "label": "Identify it again",
      "icon": "search"
     }
    ],
    "label": ""
   }
  ]
 },
 {
  "$": "screen",
  "name": "Firmware",
  "icon": "memory",
  "hidden": true,
  "tip": "Pick your board by its picture. The ones that fit its chip come first.",
  "children": [
   {
    "$": "field",
    "name": "flash_pick",
    "$type": "people",
    "empty": "No catalogue yet. Go back and tap Look again."
   }
  ]
 },
 {
  "$": "screen",
  "name": "WiFi",
  "icon": "wifi",
  "hidden": true,
  "tip": "The password is sealed to the station's key before it leaves this phone and kept nowhere on it. The station keeps a network only once it has joined it, remembers up to ten and joins whichever is in range; none can be removed from here, only on the station's own screen.",
  "children": [
   {
    "$": "group",
    "name": "Network",
    "children": [
     {
      "$": "field",
      "name": "ssid",
      "$type": "string",
      "label": "Network",
      "hint": "its name"
     },
     {
      "$": "field",
      "name": "wifi_pass",
      "$type": "secret",
      "label": "Password",
      "hint": "empty for an open network"
     }
    ]
   },
   {
    "$": "action",
    "name": "wifi_apply",
    "label": "Join",
    "style": "primary",
    "icon": "wifi"
   },
   {
    "$": "action",
    "name": "wifi_off",
    "label": "Leave WiFi",
    "icon": "power",
    "confirm": true,
    "confirm-label": "Leave the network?",
    "confirm-text": "The station drops its WiFi and stays reachable over Bluetooth and its own hotspot."
   },
   {
    "$": "field",
    "name": "wifi_now",
    "$type": "details",
    "empty": ""
   }
  ]
 },
