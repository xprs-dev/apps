    "$": "field",
    "name": "tile_info",
    "$type": "details",
    "empty": "",
    "layout": "rows"
   },
   {
    "$": "action",
    "name": "tile_room_stop",
    "label": "Stop taking new people",
    "icon": "block",
    "confirm": true,
    "confirm-label": "Stop taking new people?",
    "confirm-text": "The people it already keeps messages for stay. Newcomers choose another archiver."
   },
