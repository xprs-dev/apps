[
 {
  "$": "screen",
  "name": "Devices",
  "icon": "developer_board",
  "children": [
   {
    "$": "field",
    "name": "devices",
    "$type": "people",
    "empty_art": "media/art/stations.svg",
    "empty_title": "Looking for devices",
    "empty": "Stations and equipment on your WiFi, or near this device over Bluetooth, show up here. So do the stations you own, wherever they are.\n\nTo install XPRS on a new board, connect it with a USB cable.",
    "layout": "headers"
   },
   {
    "$": "field",
    "name": "th_scan",
    "$type": "details",
    "empty": ""
   },
   {
    "$": "action",
    "name": "refresh",
    "label": "Look again",
    "icon": "refresh"
   }
  ]
 },
 {
  "$": "screen",
  "name": "Station",
  "icon": "memory",
  "hidden": true,
  "children": [
   {
    "$": "field",
    "name": "now",
    "$type": "details",
    "empty": ""
   },
   {
    "$": "action",
    "name": "claim",
    "label": "Claim",
    "style": "primary",
    "icon": "how_to_reg",
    "tip": "Make it yours. The first owner to answer a fresh station keeps it."
   },
   {
    "$": "action",
    "name": "update",
    "label": "Update firmware",
    "style": "primary",
    "icon": "system_update",
    "confirm": true,
    "confirm-label": "Update its firmware?",
    "confirm-text": "It downloads the newest XPRS, checks its signature, restarts into it and says how it went. If the new one does not come up, it goes back to the old one by itself."
   },
   {
    "$": "field",
    "name": "st_station",
    "$type": "stats"
   },
   {
    "$": "field",
    "name": "st_diag",
    "$type": "stats"
   },
   {
    "$": "action",
    "name": "crash",
    "label": "Crash report",
    "icon": "bug_report"
   },
   {
    "$": "field",
    "name": "reaches",
    "$type": "people",
    "empty": "It has not said which stations it hears.",
    "inline": true
   },
   {
    "$": "field",
    "name": "st_place",
    "$type": "place",
    "zoom": 13
   },
   {
    "$": "field",
    "name": "st_policy",
    "$type": "details",
    "empty": "",
    "layout": "rows"
   },
   {
    "$": "action",
    "name": "room_stop",
    "label": "Stop taking new people",
    "icon": "block",
    "confirm": true,
    "confirm-label": "Stop taking new people?",
    "confirm-text": "The people it already keeps messages for stay. Newcomers choose another archiver. Every station that hears it learns this from its next announcement."
   },
   {
    "$": "action",
    "name": "room_take",
    "label": "Take new people again",
    "icon": "person_add"
   },
   {
    "$": "action",
    "name": "open_checkin",
    "label": "Check-in",
    "icon": "where_to_vote",
    "tip": "Whether people can check in here, its kind of place, greeting and badge. Opens the Check-in app on this station."
   },
   {
    "$": "action",
    "name": "open_wifi",
    "label": "WiFi",
    "icon": "wifi"
   },
   {
    "$": "action",
    "name": "open_name",
    "label": "Settings",
    "icon": "settings"
   },
   {
    "$": "action",
    "name": "open_identity",
    "label": "Callsign",
    "icon": "key"
   },
   {
    "$": "action",
    "name": "open_admins",
    "label": "Administrators",
    "icon": "people"
   },
   {
    "$": "field",
    "name": "info",
    "$type": "details",
    "empty": "",
    "layout": "rows"
   },
   {
    "$": "action",
    "name": "stats",
    "label": "Ask again",
    "icon": "refresh",
    "tip": "Ask it again for its figures and who owns it. Opening it already asks."
   },
   {
    "$": "action",
    "name": "open_answers",
    "label": "History",
    "icon": "history"
   },
   {
    "$": "action",
    "name": "forget",
    "label": "Forget",
    "style": "danger",
    "icon": "delete",
    "confirm": true,
    "confirm-label": "Forget this station?",
    "confirm-text": "It leaves the list. It is not changed, and it comes back if it is heard again."
   }
  ]
 },
 {
  "$": "screen",
  "name": "Detail",
  "icon": "info",
  "hidden": true,
