 {
  "$": "screen",
  "name": "Callsign",
  "icon": "key",
  "hidden": true,
  "tip": "A station's callsign comes from its key: X3 and the first letters of the key. A new key is a new callsign. A licensed callsign replaces it on the air and keeps the key.",
  "children": [
   {
    "$": "action",
    "name": "pick_callsign",
    "label": "Choose a callsign",
    "style": "primary",
    "icon": "search",
    "tip": "Search for a key whose callsign has the letters you like, and give it to the station."
   },
   {
    "$": "group",
    "name": "Key",
    "children": [
     {
      "$": "field",
      "name": "identity",
      "$type": "enum",
      "label": "Key",
      "default": "new",
      "children": [
       {
        "$": "option",
        "name": "new",
        "label": "New key"
       },
       {
        "$": "option",
        "name": "import",
        "label": "Import nsec"
       }
      ]
     },
     {
      "$": "field",
      "name": "nsec",
      "$type": "secret",
      "label": "nsec",
      "hint": "nsec1..., sealed to the station"
     }
    ]
   },
   {
    "$": "action",
    "name": "identity_apply",
    "label": "Apply",
    "style": "primary",
    "icon": "key",
    "confirm": true,
    "confirm-label": "Change its key?",
    "confirm-text": "The station restarts under a new callsign. Anyone who knew the old one has to learn the new one."
   },
   {
    "$": "group",
    "name": "Licensed callsign",
    "children": [
     {
      "$": "field",
      "name": "call",
      "$type": "string",
      "label": "Callsign",
      "hint": "CT1ABC",
      "max": 11
     }
    ]
   },
   {
    "$": "action",
    "name": "call_apply",
    "label": "Use this callsign",
    "icon": "cell_tower",
    "confirm": true,
    "confirm-label": "Transmit under this callsign?",
    "confirm-text": "The station restarts and transmits under it, with the same key. Only a callsign issued to you may be used on amateur bands."
   },
   {
    "$": "action",
    "name": "call_derived",
    "label": "Use derived callsign",
    "icon": "key",
    "confirm": true,
    "confirm-label": "Go back to its derived callsign?",
    "confirm-text": "The station restarts under the callsign its key derives."
   },
   {
    "$": "field",
    "name": "callsign_now",
    "$type": "details",
    "empty": ""
   }
