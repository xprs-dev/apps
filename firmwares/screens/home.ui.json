[
  {
    "$": "screen",
    "name": "Stations",
    "icon": "developer_board",
    "children": [
      {
        "$": "field",
        "name": "stations",
        "$type": "people",
        "empty": "No station yet.\n\nFlash one from xprs.dev/firmware and keep this phone next to it: within half a minute it asks to be claimed and appears here.\n\nA board without Bluetooth: join its hotspot, XPRS- and its callsign."
      }
    ]
  },
  {
    "$": "screen",
    "name": "Flash",
    "icon": "usb",
    "tip": "Boards plugged in over USB. Tap one to flash it.",
    "children": [
      { "$": "field", "name": "flash_hub", "$type": "stats" },
      { "$": "action", "name": "flash_refresh", "label": "Refresh", "style": "primary", "icon": "refresh" },
      {
        "$": "field",
        "name": "flash",
        "$type": "people",
        "empty": "No board on USB.\n\nPlug one in (an OTG cable on a phone), then Refresh from the menu at the top right."
      }
    ]
  },
  {
    "$": "screen",
    "name": "Device",
    "icon": "usb",
    "hidden": true,
    "tip": "1. Wait for the chip to be identified.  2. Choose the firmware, unless one already fits.  3. Flash.",
    "children": [
      { "$": "action", "name": "flash_write", "label": "Flash", "style": "primary", "icon": "usb",
        "confirm": true, "confirm-label": "Write the firmware?",
        "confirm-text": "The board's firmware is replaced and verified. Keep it plugged in until it says done." },
      { "$": "action", "name": "flash_choose", "label": "Choose firmware", "icon": "list" },
      { "$": "action", "name": "flash_cancel", "label": "Stop", "style": "danger", "icon": "stop" },
      { "$": "field", "name": "dev_now", "$type": "details", "empty": "" },
      { "$": "field", "name": "dev_hub", "$type": "stats" },
      { "$": "field", "name": "wipe", "$type": "bool", "label": "Wipe settings", "default": false,
        "tip": "Off keeps the station's key, owner and WiFi. On makes it a new station." },
      { "$": "action", "name": "flash_identify", "label": "Identify again", "icon": "search" },
      { "$": "action", "name": "back", "label": "Back", "icon": "close" }
    ]
  },
  {
    "$": "screen",
    "name": "Firmware",
    "icon": "memory",
    "hidden": true,
    "tip": "Pick your board by its picture. The ones that fit the chip come first.",
    "children": [
      { "$": "field", "name": "flash_pick", "$type": "people", "empty": "No catalogue yet. Refresh on the Flash tab." }
    ]
  },
  {
    "$": "screen",
    "name": "Station",
    "icon": "memory",
    "hidden": true,
    "children": [
      { "$": "field", "name": "hub", "$type": "stats" },
      { "$": "field", "name": "now", "$type": "details", "empty": "" },
      { "$": "action", "name": "claim", "label": "Claim", "style": "primary", "icon": "how_to_reg",
        "tip": "Make it yours. The first owner to answer a fresh station keeps it." },
      { "$": "action", "name": "open_wifi", "label": "WiFi", "icon": "wifi" },
      { "$": "action", "name": "open_name", "label": "Name", "icon": "label" },
      { "$": "action", "name": "open_identity", "label": "Identity", "icon": "key" },
      { "$": "action", "name": "open_stats", "label": "Stats", "icon": "monitor_heart" },
      { "$": "action", "name": "open_answers", "label": "Answers", "icon": "history" },
      { "$": "action", "name": "forget", "label": "Forget", "style": "danger", "icon": "delete",
        "confirm": true, "confirm-label": "Forget this station?",
        "confirm-text": "It leaves the list. It is not changed, and it comes back if it asks again." }
    ]
  },
  {
    "$": "screen",
    "name": "WiFi",
    "icon": "wifi",
    "hidden": true,
    "tip": "The password is sealed to the station's key before it leaves this phone and kept nowhere on it.",
    "children": [
      {
        "$": "group",
        "name": "Network",
        "children": [
          { "$": "field", "name": "ssid", "$type": "string", "label": "Network", "hint": "its name" },
          { "$": "field", "name": "wifi_pass", "$type": "secret", "label": "Password", "hint": "empty for an open network" }
        ]
      },
      { "$": "action", "name": "wifi_apply", "label": "Join", "style": "primary", "icon": "wifi" },
      { "$": "action", "name": "wifi_off", "label": "Leave WiFi", "icon": "power",
        "confirm": true, "confirm-label": "Leave the network?",
        "confirm-text": "The station drops its WiFi and stays reachable over Bluetooth and its own hotspot." },
      { "$": "field", "name": "wifi_now", "$type": "details", "empty": "" },
      { "$": "action", "name": "back", "label": "Back", "icon": "close" }
    ]
  },
  {
    "$": "screen",
    "name": "Name",
    "icon": "label",
    "hidden": true,
    "children": [
      {
        "$": "group",
        "name": "Station",
        "children": [
          { "$": "field", "name": "nick", "$type": "string", "label": "Name", "hint": "roof-north", "max": 16 },
          { "$": "field", "name": "zone", "$type": "enum", "label": "Time zone", "default": "auto",
            "children": [
              { "$": "option", "name": "auto", "label": "Auto (looked up online)" },
              { "$": "option", "name": "-12:00", "label": "-12:00" },
              { "$": "option", "name": "-11:00", "label": "-11:00" },
              { "$": "option", "name": "-10:00", "label": "-10:00" },
              { "$": "option", "name": "-09:00", "label": "-09:00" },
              { "$": "option", "name": "-08:00", "label": "-08:00" },
              { "$": "option", "name": "-07:00", "label": "-07:00" },
              { "$": "option", "name": "-06:00", "label": "-06:00" },
              { "$": "option", "name": "-05:00", "label": "-05:00" },
              { "$": "option", "name": "-04:00", "label": "-04:00" },
              { "$": "option", "name": "-03:00", "label": "-03:00" },
              { "$": "option", "name": "-02:00", "label": "-02:00" },
              { "$": "option", "name": "-01:00", "label": "-01:00" },
              { "$": "option", "name": "+00:00", "label": "+00:00 UTC" },
              { "$": "option", "name": "+01:00", "label": "+01:00" },
              { "$": "option", "name": "+02:00", "label": "+02:00" },
              { "$": "option", "name": "+03:00", "label": "+03:00" },
              { "$": "option", "name": "+04:00", "label": "+04:00" },
              { "$": "option", "name": "+05:00", "label": "+05:00" },
              { "$": "option", "name": "+05:30", "label": "+05:30" },
              { "$": "option", "name": "+06:00", "label": "+06:00" },
              { "$": "option", "name": "+07:00", "label": "+07:00" },
              { "$": "option", "name": "+08:00", "label": "+08:00" },
              { "$": "option", "name": "+09:00", "label": "+09:00" },
              { "$": "option", "name": "+10:00", "label": "+10:00" },
              { "$": "option", "name": "+11:00", "label": "+11:00" },
              { "$": "option", "name": "+12:00", "label": "+12:00" },
              { "$": "option", "name": "+13:00", "label": "+13:00" },
              { "$": "option", "name": "+14:00", "label": "+14:00" }
            ] },
          { "$": "field", "name": "hotspot", "$type": "enum", "label": "Hotspot", "default": "same",
            "children": [
              { "$": "option", "name": "same", "label": "Keep" },
              { "$": "option", "name": "on", "label": "On" },
              { "$": "option", "name": "off", "label": "Off" }
            ] }
        ]
      },
      { "$": "action", "name": "station_apply", "label": "Save", "style": "primary", "icon": "save" },
      { "$": "action", "name": "back", "label": "Back", "icon": "close" }
    ]
  },
  {
    "$": "screen",
    "name": "Identity",
    "icon": "key",
    "hidden": true,
    "tip": "A station's callsign comes from its key. A new key is a new callsign.",
    "children": [
      {
        "$": "group",
        "name": "Key",
        "children": [
          { "$": "field", "name": "identity", "$type": "enum", "label": "Key", "default": "new",
            "children": [
              { "$": "option", "name": "new", "label": "New key" },
              { "$": "option", "name": "import", "label": "Import nsec" }
            ] },
          { "$": "field", "name": "nsec", "$type": "secret", "label": "nsec", "hint": "nsec1..., sealed to the station" }
        ]
      },
      { "$": "action", "name": "identity_apply", "label": "Apply", "style": "primary", "icon": "key",
        "confirm": true, "confirm-label": "Change its key?",
        "confirm-text": "The station restarts under a new callsign. Anyone who knew the old one has to learn the new one." },
      { "$": "action", "name": "back", "label": "Back", "icon": "close" }
    ]
  },
  {
    "$": "screen",
    "name": "Stats",
    "icon": "monitor_heart",
    "hidden": true,
    "children": [
      { "$": "group", "name": "Station", "children": [
        { "$": "field", "name": "st_station", "$type": "stats" },
        { "$": "field", "name": "st_hears", "$type": "details", "empty": "" }
      ] },
      { "$": "group", "name": "Policy", "children": [
        { "$": "field", "name": "st_policy", "$type": "stats" }
      ] },
      { "$": "group", "name": "Diagnostics", "children": [
        { "$": "field", "name": "st_diag", "$type": "stats" }
      ] },
      { "$": "action", "name": "stats", "label": "Refresh", "style": "primary", "icon": "refresh" },
      { "$": "action", "name": "crash", "label": "Crash report", "icon": "bug_report" },
      { "$": "action", "name": "back", "label": "Back", "icon": "close" }
    ]
  },
  {
    "$": "screen",
    "name": "Answers",
    "icon": "history",
    "hidden": true,
    "children": [
      { "$": "field", "name": "log", "$type": "log", "label": "What the station said" },
      { "$": "action", "name": "log_clear", "label": "Clear", "icon": "delete" },
      { "$": "action", "name": "back", "label": "Back", "icon": "close" }
    ]
  }
]
