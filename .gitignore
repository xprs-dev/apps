# Per-wapp build artefacts and runtime state.
*.wasm.tmp
*~
*.swp
.DS_Store

# Per-wapp social store files generated when a wapp runs in dev.
# The shipped social DBs live inside the .wapp ZIP under
# binaries/, not in the source folders.
*/social.sqlite3

# Local profile leakage if someone mounts a profile folder here.
*/kv.json

# Editor / OS noise.
.vscode/
.idea/

# mp4player's vendored decoders compile to per-source objects next to their
# sources. They are build output: the Makefile regenerates them, and the
# repo has never tracked them (vendor/aac_dec.o is a committed artefact and
# stays one). Without this they show up as 150 untracked files after every
# mp4player build.
mp4player/vendor/pvaac/*.o
mp4player/vendor/openh264/**/*.o
mp4player/vendor/vpx/**/*.o
mp4player/vendor/de265/**/*.o
mp4player/vendor/nestegg/**/*.o
