[
  {
    "$": "screen",
    "name": "Bots",
    "icon": "smart_toy",
    "toolbar": true,
    "tip": "A bot is a program with its own X2 callsign. It answers the command words you teach it, and messages written to it.",
    "children": [
      {
        "$": "field",
        "name": "bots",
        "$type": "people",
        "empty_title": "No bots yet",
        "empty": "Create one, teach it a few command words and start it. Others see its X2 callsign and know they are talking to a program."
      },
      {
        "$": "action",
        "name": "new_bot",
        "label": "New bot",
        "style": "primary",
        "icon": "add"
      }
    ]
  },
  {
    "$": "screen",
    "name": "Bot",
    "icon": "smart_toy",
    "hidden": true,
    "children": [
      { "$": "field", "name": "b_info", "$type": "details", "empty": "" },
      { "$": "action", "name": "b_start", "label": "Start", "style": "primary", "icon": "play" },
      { "$": "action", "name": "b_stop", "label": "Stop", "icon": "stop" },
      {
        "$": "group",
        "name": "What it is",
        "children": [
          { "$": "field", "name": "b_nick", "$type": "string", "label": "Name", "hint": "weather, door, helper", "max": 24 },
          { "$": "field", "name": "b_about", "$type": "string", "label": "A line about it", "hint": "what it does, for whoever meets it", "max": 80 }
        ]
      },
      {
        "$": "group",
        "name": "What it answers",
        "children": [
          {
            "$": "field", "name": "b_rules", "$type": "text", "multiline": true, "lines": 8,
            "label": "Command words and replies, one per line",
            "hint": "forecast = Rain from 16:00"
          },
          { "$": "field", "name": "b_hello", "$type": "string", "label": "Reply to any other message", "hint": "leave empty to stay silent", "max": 160 },
          { "$": "field", "name": "b_ai", "$type": "bool", "label": "Let the AI answer other messages", "default": false },
          { "$": "field", "name": "b_prompt", "$type": "text", "multiline": true, "lines": 5, "label": "What the AI should know and do", "hint": "You answer questions about our hiking club. We meet on Saturdays." }
        ]
      },
      {
        "$": "group",
        "name": "Who it is there for",
        "children": [
          {
            "$": "field", "name": "b_reach", "$type": "enum", "label": "How far it reaches", "default": "global",
            "children": [
              { "$": "option", "name": "global", "label": "Everywhere, like a person" },
              { "$": "option", "name": "regional", "label": "The region: radio, no internet" },
              { "$": "option", "name": "local", "label": "Here: Bluetooth and WiFi only" }
            ]
          },
          {
            "$": "field", "name": "b_talk", "$type": "enum", "label": "It answers messages from", "default": "all",
            "children": [
              { "$": "option", "name": "all", "label": "Anybody" },
              { "$": "option", "name": "list", "label": "Me and the people below" },
              { "$": "option", "name": "owner", "label": "Only me" }
            ]
          },
          {
            "$": "field", "name": "b_allow", "$type": "enum", "label": "It takes commands from", "default": "owner",
            "children": [
              { "$": "option", "name": "owner", "label": "Only me" },
              { "$": "option", "name": "list", "label": "Me and the people below" },
              { "$": "option", "name": "all", "label": "Anybody" }
            ]
          },
          { "$": "field", "name": "b_list", "$type": "string", "label": "The people I chose", "hint": "X1ABCD, X1EFGH", "max": 120 },
          { "$": "action", "name": "pick_open", "label": "Choose from people I know", "icon": "people" }
        ]
      },
      { "$": "action", "name": "b_save", "label": "Save", "style": "primary", "icon": "check" },
      { "$": "field", "name": "b_log", "$type": "details", "empty": "Nobody has written to it yet." },
      { "$": "action", "name": "b_delete", "label": "Delete this bot", "icon": "delete" },
      { "$": "action", "name": "back", "label": "Back", "icon": "close" }
    ]
  },
  {
    "$": "screen",
    "name": "People",
    "icon": "people",
    "hidden": true,
    "search": true,
    "toolbar": true,
    "children": [
      {
        "$": "field",
        "name": "pick",
        "$type": "people",
        "empty_title": "Nobody to choose yet",
        "empty": "People you wrote down in People, and people heard lately, are listed here. A callsign can also be typed on the bot's page."
      },
      { "$": "action", "name": "pick_done", "label": "Done", "style": "primary", "icon": "check" }
    ]
  }
]
