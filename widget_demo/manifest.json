{
  "id":              "tools.xprs.widget-demo",
  "version":         "1.0.3",
  "kind":            "system",
  "title":           "Functionality Demo",
  "description":     "A demo wapp that provides several functionalities.",
  "summary":         "A small example of one wapp that provides more than one functionality. It answers widget requests for text.greet and text.shout with fixed results.",
  "icon":            "media/icons/widget-demo.svg",
  "tags":            ["system", "demo", "widgets"],
  "entry_ui":        "screens/home.ui.json",
  "tick_interval_ms": 5000,
  "permissions":     [],
  "provides": {
    "functions": [],
    "events":    [],
    "variables": [],
    "functionalities": [
      {
        "id": "text.greet",
        "description": "Returns a greeting message for a given name",
        "endpoints": [
          {
            "name": "greet",
            "description": "Greet someone by name",
            "params": [{"name": "name", "type": "string", "description": "Who to greet"}],
            "returns": {"type": "object", "description": "Greeting result", "fields": {"greeting": "string"}}
          }
        ]
      },
      {
        "id": "text.shout",
        "description": "Returns an uppercase exclamation",
        "endpoints": [
          {
            "name": "shout",
            "description": "Shout a message",
            "params": [],
            "returns": {"type": "object", "description": "Shout result", "fields": {"loud": "string"}}
          }
        ]
      }
    ]
  },
  "requires": {
    "hal":       ["log", "msg"],
    "events":    [],
    "libraries": [],
    "variables": []
  }
}
