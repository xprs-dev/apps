{
  "id":              "tools.xprs.mp4player",
  "version":         "2.0.3",
  "kind":            "app",
  "title":           "Player",
  "description":     "Play your music and videos.",
  "summary":         "Add your music folders in Settings and play them. It plays common video formats like H.264 and HEVC and AV1. It also plays common audio like MP3 and FLAC and Opus. The decoders run inside the wapp so files play the same on every platform. On desktop it uses built-in ffmpeg decoders for speed. Other wapps use it to open video and audio from chats or the file browser.",
  "icon":            "media/icons/mp4player.svg",
  "entry_ui":        "screens/home.ui.json",
  "tags":            ["video", "audio", "mp4", "h264", "hevc", "h265", "av1", "webm", "vp9", "opus", "aac", "mp3", "ogg", "flac", "media", "player"],
  "tick_interval_ms": 16,
  "permissions":     ["storage", "network"],
  "platforms":       ["linux", "windows", "macos", "android", "ios"],
  "hardware":        ["intel", "arm"],
  "provides": {
    "functionalities": ["media.video", "media.audio"],
    "native_binaries": {
      "linux-x86_64":   "bin/ffmpeg-linux-x86_64",
      "windows-x86_64": "bin/ffmpeg-win-x86_64.exe"
    },
    "file_handlers": [
      {
        "extensions": ["mp4", "m4v", "mov", "webm", "mkv"],
        "mime":       ["video/mp4", "video/quicktime", "video/webm", "video/x-matroska"],
        "title":      "Play",
        "modes":      ["view"]
      },
      {
        "extensions": ["mp3", "ogg", "oga", "flac", "wav", "m4a", "opus"],
        "mime":       ["audio/mpeg", "audio/ogg", "audio/flac", "audio/wav", "audio/x-wav", "audio/mp4", "audio/aac", "audio/opus"],
        "title":      "Play",
        "modes":      ["view"]
      }
    ],
    "events":         [],
    "variables":      []
  },
  "requires": {
    "hal":            ["log", "kv", "msg", "file", "video"],
    "functionalities": [],
    "events":         [],
    "libraries":      [],
    "variables":      []
  }
}
