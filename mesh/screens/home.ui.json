[
  {
    "$": "screen",
    "name": "@screen.stations",
    "icon": "cell_tower",
    "tip": "@screen.stations_tip",
    "children": [
      {
        "$": "group",
        "name": "stations-map",
        "$type": "map",
        "drawer": true,
        "tile-url": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
        "tile-style": "dark",
        "default-lat": 30,
        "default-lon": 0,
        "default-zoom": 2,
        "min-zoom": 2,
        "max-zoom": 18,
        "radius": false,
        "chat": false,
        "search": false
      },
      {
        "$": "group",
        "name": "network-graph",
        "$type": "graph"
      },
      {
        "$": "field",
        "name": "st_tags",
        "$type": "chips"
      },
      {
        "$": "field",
        "name": "stations",
        "$type": "people",
        "empty_title": "@stations.empty_title",
        "empty": "@stations.empty"
      }
    ],
    "search": true
  },
  {
    "$": "screen",
    "name": "Station",
    "icon": "cell_tower",
    "hidden": true,
    "children": [
      {
        "$": "field",
        "name": "s_ways",
        "$type": "route"
      },
      {
        "$": "field",
        "name": "s_offers",
        "$type": "people",
        "empty": ""
      }
    ]
  },
  {
    "$": "screen",
    "name": "Room",
    "icon": "folder",
    "hidden": true,
    "children": [
      {
        "$": "field",
        "name": "r_folders",
        "$type": "people",
        "empty": ""
      }
    ]
  },
  {
    "$": "screen",
    "name": "Folder",
    "icon": "folder",
    "hidden": true,
    "children": [
      {
        "$": "field",
        "name": "f_info",
        "$type": "details",
        "empty": ""
      },
      {
        "$": "field",
        "name": "f_media",
        "$type": "media"
      },
      {
        "$": "action",
        "name": "f_more",
        "label": "@folder.more",
        "icon": "expand_more"
      },
      {
        "$": "action",
        "name": "f_first",
        "label": "@folder.first",
        "icon": "first_page"
      }
    ]
  }
]
