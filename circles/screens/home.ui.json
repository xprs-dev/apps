[
  {
    "$": "screen",
    "name": "@screen.circles",
    "icon": "group",
    "tip": "@screen.circles_tip",
    "children": [
      {
        "$": "group",
        "name": "conversations",
        "$type": "conversations",
        "label": "@screen.circles",
        "children": [
          { "$": "action", "name": "new_circle", "icon": "add", "slot": "list", "tip": "@action.new_circle_tip" },
          { "$": "action", "name": "join_circle", "icon": "person_add", "slot": "list", "tip": "@action.join_circle_tip" },
          { "$": "action", "name": "edit_circle", "icon": "edit", "slot": "room", "label": "@action.edit_circle", "tip": "@action.edit_circle_tip" },
          { "$": "action", "name": "manage_people", "icon": "people", "slot": "room", "label": "@action.people", "tip": "@action.people_tip" },
          { "$": "action", "name": "folder_new", "icon": "add", "slot": "room", "label": "@action.folder_new", "tip": "@action.folder_new_tip" },
          { "$": "action", "name": "share_circle", "icon": "share", "slot": "room", "label": "@action.share", "tip": "@action.share_tip" },
          { "$": "action", "name": "delete_circle", "icon": "delete", "slot": "room", "label": "@action.delete_circle", "tip": "@action.delete_circle_tip" }
        ]
      }
    ]
  },
  {
    "$": "screen",
    "name": "@screen.edit_circle",
    "hidden": true,
    "children": [
      {
        "$": "group",
        "name": "@group.circle",
        "children": [
          { "$": "field", "name": "edit_pic", "$type": "image", "label": "@field.picture", "tip": "@field.picture_tip" },
          { "$": "field", "name": "edit_name", "$type": "string", "label": "@field.name", "hint": "@field.circle_name_hint", "max": 40 },
          { "$": "field", "name": "edit_desc", "$type": "string", "label": "@field.description", "hint": "@field.circle_desc_hint", "multiline": true, "lines": 4, "max": 250 }
        ]
      },
      {
        "$": "group",
        "name": "@group.roles",
        "tip": "@group.roles_tip",
        "children": [
          { "$": "action", "name": "manage_roles", "label": "@action.manage_roles", "icon": "tune" }
        ]
      },
      { "$": "action", "name": "edit_save", "label": "@action.save", "icon": "save", "style": "primary" }
    ]
  },
  {
    "$": "screen",
    "name": "@screen.roles",
    "hidden": true,
    "children": [
      { "$": "field", "name": "roles", "$type": "people", "empty": "@label.roles_empty" }
    ]
  },
  {
    "$": "screen",
    "name": "@screen.edit_role",
    "hidden": true,
    "children": [
      {
        "$": "group",
        "name": "@group.role",
        "children": [
          { "$": "field", "name": "role_name", "$type": "string", "label": "@field.name", "hint": "@field.role_name_hint", "max": 40 },
          { "$": "field", "name": "role_desc", "$type": "string", "label": "@field.description", "hint": "@field.role_desc_hint", "multiline": true, "lines": 3, "max": 200 },
          { "$": "field", "name": "role_default", "$type": "bool", "label": "@field.role_default" }
        ]
      },
      { "$": "action", "name": "role_save", "label": "@action.save_role", "icon": "save", "style": "primary" },
      { "$": "action", "name": "role_delete", "label": "@action.delete_role", "icon": "delete" }
    ]
  },
  {
    "$": "screen",
    "name": "@screen.share_circle",
    "hidden": true,
    "children": [
      { "$": "field", "name": "share_qr", "$type": "qr", "tip": "@field.share_qr_tip" },
      { "$": "field", "name": "share_link", "$type": "string", "label": "@field.link", "readonly": true, "copy": true, "tip": "@field.link_tip" },
      { "$": "field", "name": "share_id", "$type": "string", "label": "@field.full_key", "readonly": true, "copy": true, "tip": "@field.full_key_tip" },
      { "$": "field", "name": "share_short", "$type": "string", "label": "@field.short_code", "readonly": true, "copy": true, "tip": "@field.short_code_tip" }
    ]
  },
  {
    "$": "screen",
    "name": "@screen.people",
    "hidden": true,
    "children": [
      { "$": "field", "name": "members", "$type": "people", "empty": "@label.people_empty" }
    ]
  },
  {
    "$": "screen",
    "name": "@screen.folder_view",
    "hidden": true,
    "children": [
      { "$": "field", "name": "folderrail", "$type": "rail" },
      { "$": "field", "name": "folderchat", "$type": "chat", "hint": "@field.folder_chat_hint" },
      { "$": "action", "name": "folder_new", "label": "@action.new_subfolder", "icon": "create_new_folder" },
      { "$": "action", "name": "folder_settings", "label": "@action.folder_settings", "icon": "settings" },
      { "$": "action", "name": "folder_access_cur", "label": "@action.access", "icon": "lock" }
    ]
  },
  {
    "$": "screen",
    "name": "@screen.folder_editor",
    "hidden": true,
    "children": [
      {
        "$": "group",
        "name": "@group.folder",
        "children": [
          { "$": "field", "name": "folder_name", "$type": "string", "label": "@field.name", "hint": "@field.folder_name_hint", "max": 48 },
          { "$": "field", "name": "folder_desc", "$type": "string", "label": "@field.description", "hint": "@field.folder_desc_hint", "multiline": true, "lines": 3, "max": 200 },
          { "$": "field", "name": "folder_icon", "$type": "icon", "label": "@field.icon" },
          {
            "$": "field", "name": "folder_type", "$type": "enum", "label": "@field.type",
            "tip": "@field.type_tip",
            "children": [
              { "$": "option", "name": "chat", "label": "@option.chat" },
              { "$": "option", "name": "folder", "label": "@option.folder" },
              { "$": "option", "name": "blog", "label": "@option.blog" },
              { "$": "option", "name": "gallery", "label": "@option.gallery" },
              { "$": "option", "name": "forum", "label": "@option.forum" }
            ]
          }
        ]
      },
      { "$": "action", "name": "folder_save", "label": "@action.save_folder", "icon": "save", "style": "primary" },
      { "$": "action", "name": "folder_delete", "label": "@action.delete_folder", "icon": "delete" }
    ]
  },
  {
    "$": "screen",
    "name": "@screen.folder_access",
    "hidden": true,
    "children": [
      { "$": "field", "name": "faccess", "$type": "people", "empty": "@label.access_empty" }
    ]
  }
]
