[
  {
    "$": "screen",
    "name": "@screen.mail",
    "icon": "mail",
    "tip": "@screen.mail_tip",
    "children": [
      {
        "$": "group",
        "name": "conversations",
        "$type": "conversations",
        "label": "@group.conversations",
        "children": [
          { "$": "action", "name": "new_message", "icon": "edit", "slot": "list",
            "tip": "@action.new_message_tip" }
        ]
      }
    ]
  },
  {
    "$": "screen",
    "name": "@screen.email",
    "icon": "alternate_email",
    "menu": true,
    "tip": "@screen.email_tip",
    "children": [
      { "$": "field", "name": "email_status", "$type": "log", "label": "@field.email_status" },
      { "$": "action", "name": "set_email", "label": "@action.set_email", "icon": "edit" },
      { "$": "action", "name": "verify_email", "label": "@action.verify_email", "icon": "verified" }
    ]
  },
  {
    "$": "screen",
    "name": "@screen.blocked",
    "icon": "block",
    "menu": true,
    "tip": "@screen.blocked_tip",
    "children": [
      { "$": "field", "name": "blocked", "$type": "log", "label": "@field.blocked" },
      { "$": "action", "name": "block_key", "label": "@action.block_key", "icon": "block" },
      { "$": "action", "name": "unblock", "label": "@action.unblock", "icon": "person_add" },
      { "$": "action", "name": "refresh_blocked", "label": "@action.refresh", "icon": "refresh" }
    ]
  },
  {
    "$": "screen",
    "name": "@screen.status",
    "icon": "info",
    "menu": true,
    "tip": "@screen.status_tip",
    "children": [
      { "$": "field", "name": "status", "$type": "log", "label": "@field.delivery" },
      { "$": "action", "name": "refresh_status", "label": "@action.refresh", "icon": "refresh" }
    ]
  }
]
