[
  {
    "$": "screen",
    "name": "Things",
    "icon": "power",
    "children": [
      {
        "$": "action",
        "name": "scan",
        "label": "Scan",
        "style": "primary",
        "icon": "radar"
      },
      {
        "$": "field",
        "name": "th_scan",
        "$type": "details",
        "empty": ""
      },
      {
        "$": "field",
        "name": "things",
        "$type": "people",
        "empty": "No device yet.\n\nA device (an X4 callsign: a pump, a generator, a sensor, a plug) appears here when its controller is heard nearby or answers a Scan, or once this station's archive holds its identity.\n\nTap one and Pin it to keep its readings, in range or not."
      }
    ]
  },
  {
    "$": "screen",
    "name": "Thing",
    "icon": "monitor_heart",
    "hidden": true,
    "children": [
      {
        "$": "field",
        "name": "th_pic",
        "$type": "image",
        "shape": "wide",
        "readonly": true,
        "label": ""
      },
      {
        "$": "action",
        "name": "live",
        "label": "Watch live",
        "style": "primary",
        "icon": "videocam"
      },
      {
        "$": "action",
        "name": "unlive",
        "label": "Stop watching",
        "icon": "stop"
      },
      {
        "$": "action",
        "name": "snap",
        "label": "Picture now",
        "icon": "image"
      },
      {
        "$": "field",
        "name": "th_picnote",
        "$type": "details",
        "empty": ""
      },
      {
        "$": "field",
        "name": "th_conn",
        "$type": "details",
        "empty": ""
      },
      {
        "$": "action",
        "name": "connect",
        "label": "Connect",
        "style": "primary",
        "icon": "link"
      },
      {
        "$": "field",
        "name": "th_now",
        "$type": "stats"
      },
      {
        "$": "action",
        "name": "watch",
        "label": "Warn when it rings",
        "style": "primary",
        "icon": "campaign"
      },
      {
        "$": "action",
        "name": "unwatch",
        "label": "Stop warning",
        "icon": "campaign"
      },
      {
        "$": "action",
        "name": "watch_move",
        "label": "Warn when it sees movement",
        "icon": "radar"
      },
      {
        "$": "action",
        "name": "unwatch_move",
        "label": "Stop warning about movement",
        "icon": "radar"
      },
      {
        "$": "field",
        "name": "th_events",
        "$type": "details",
        "empty": "Nothing reported yet."
      },
      {
        "$": "action",
        "name": "th_more",
        "label": "Details and settings",
        "icon": "settings"
      },
      {
        "$": "action",
        "name": "th_less",
        "label": "Hide details",
        "icon": "expand_less"
      },
      {
        "$": "action",
        "name": "disconnect",
        "label": "Disconnect",
        "icon": "link_off"
      },
      {
        "$": "action",
        "name": "pin",
        "label": "Pin",
        "style": "primary",
        "icon": "star"
      },
      {
        "$": "action",
        "name": "unpin",
        "label": "Unpin",
        "icon": "star"
      },
      {
        "$": "group",
        "name": "About",
        "children": [
          {
            "$": "field",
            "name": "th_about",
            "$type": "details",
            "empty": ""
          },
          {
            "$": "field",
            "name": "th_totals",
            "$type": "details",
            "empty": ""
          },
          {
            "$": "field",
            "name": "th_can",
            "$type": "details",
            "empty": ""
          }
        ]
      },
      {
        "$": "group",
        "name": "Settings",
        "children": [
          {
            "$": "field",
            "name": "th_name",
            "$type": "string",
            "label": "Name on this device",
            "hint": "front door, garage, shed - what you call it"
          },
          {
            "$": "field",
            "name": "th_class",
            "$type": "enum",
            "label": "Treat it as",
            "default": "auto",
            "children": [
              {
                "$": "option",
                "name": "auto",
                "label": "Work it out from what it says"
              },
              {
                "$": "option",
                "name": "doorbell",
                "label": "Doorbell"
              },
              {
                "$": "option",
                "name": "camera",
                "label": "Camera"
              },
              {
                "$": "option",
                "name": "motion",
                "label": "Movement sensor"
              },
              {
                "$": "option",
                "name": "lock",
                "label": "Lock"
              },
              {
                "$": "option",
                "name": "cover",
                "label": "Gate or valve"
              },
              {
                "$": "option",
                "name": "thermostat",
                "label": "Thermostat"
              },
              {
                "$": "option",
                "name": "meter",
                "label": "Meter"
              },
              {
                "$": "option",
                "name": "switch",
                "label": "Switch"
              },
              {
                "$": "option",
                "name": "sensor",
                "label": "Sensor"
              },
              {
                "$": "option",
                "name": "thing",
                "label": "Device"
              }
            ]
          },
          {
            "$": "field",
            "name": "th_url",
            "$type": "string",
            "label": "Picture address",
            "hint": "http://192.168.1.9/door/snapshot.jpg"
          },
          {
            "$": "field",
            "name": "th_vendor",
            "$type": "enum",
            "label": "How to reach it",
            "default": "link",
            "children": [
              {
                "$": "option",
                "name": "link",
                "label": "Fetch the address above"
              },
              {
                "$": "option",
                "name": "reolink",
                "label": "Reolink camera (log in to it)"
              }
            ]
          },
          {
            "$": "field",
            "name": "th_host",
            "$type": "string",
            "label": "Address on the network",
            "hint": "192.168.1.9"
          },
          {
            "$": "field",
            "name": "th_user",
            "$type": "string",
            "label": "User",
            "hint": "admin"
          },
          {
            "$": "field",
            "name": "th_pass",
            "$type": "secret",
            "label": "Password",
            "hint": "kept sealed to this device; empty leaves it unchanged"
          },
          {
            "$": "field",
            "name": "th_path",
            "$type": "string",
            "label": "Picture path",
            "hint": "/door/snapshot.jpg"
          },
          {
            "$": "action",
            "name": "th_apply",
            "label": "Save",
            "style": "primary",
            "icon": "check"
          },
          {
            "$": "action",
            "name": "th_forget",
            "label": "Work it out again",
            "icon": "refresh"
          }
        ]
      },
      {
        "$": "action",
        "name": "back",
        "label": "Back",
        "icon": "close"
      }
