  },
  {
    "$": "screen",
    "name": "Live",
    "icon": "videocam",
    "hidden": true,
    "children": [
      {
        "$": "group",
        "name": "live-surface",
        "$type": "video",
        "controls": "none",
        "fit": "contain"
      }
    ]
  }
]
