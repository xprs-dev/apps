[
  {
    "$": "screen",
    "name": "Nearby",
    "icon": "campaign",
    "children": [
      {
        "$": "field",
        "name": "alerts",
        "$type": "people",
        "empty_title": "No alerts here",
        "empty": "An alert is a warning or a notice about this place: a flooded car park, a closed gate, a storm on its way.\n\nAlerts posted nearby show up here, and a station keeps its owner's alerts and gives each one to whoever arrives, once.\n\nTo post one, open the Post tab."
      }
    ]
  },
  {
    "$": "screen",
    "name": "Post",
    "icon": "add_alert",
    "tip": "Goes out over Bluetooth and the local network only, never further. A station you own keeps it and gives it to everybody who arrives until it ends.",
    "children": [
      {
        "$": "group",
        "name": "Alert",
        "children": [
          { "$": "field", "name": "a_type", "$type": "enum", "label": "Type", "default": "warning",
            "children": [
              { "$": "option", "name": "warning", "label": "Warning: a hazard" },
              { "$": "option", "name": "info", "label": "Notice: worth knowing" }
            ] },
          { "$": "field", "name": "a_sev", "$type": "enum", "label": "How bad (warnings)", "default": "watch",
            "children": [
              { "$": "option", "name": "watch", "label": "Watch: may affect you, be ready" },
              { "$": "option", "name": "warning", "label": "Warning: will affect you, act now" },
              { "$": "option", "name": "danger", "label": "Danger: life-threatening, leave" }
            ] },
          { "$": "field", "name": "a_kind", "$type": "enum", "label": "What", "default": "other",
            "children": [
              { "$": "option", "name": "other", "label": "Other" },
              { "$": "option", "name": "fire", "label": "Fire (warning)" },
              { "$": "option", "name": "flood", "label": "Flood (warning)" },
              { "$": "option", "name": "storm", "label": "Storm (warning)" },
              { "$": "option", "name": "wind", "label": "Wind" },
              { "$": "option", "name": "snow", "label": "Snow" },
              { "$": "option", "name": "ice", "label": "Ice" },
              { "$": "option", "name": "quake", "label": "Earthquake (warning)" },
              { "$": "option", "name": "tsunami", "label": "Tsunami (warning)" },
              { "$": "option", "name": "landslide", "label": "Landslide (warning)" },
              { "$": "option", "name": "chemical", "label": "Chemical (warning)" },
              { "$": "option", "name": "radiation", "label": "Radiation (warning)" },
              { "$": "option", "name": "outage", "label": "Outage (warning)" },
              { "$": "option", "name": "road", "label": "Road (warning)" },
              { "$": "option", "name": "crowd", "label": "Crowd" },
              { "$": "option", "name": "animal", "label": "Animal" },
              { "$": "option", "name": "traffic", "label": "Traffic (notice)" },
              { "$": "option", "name": "stopped", "label": "Stopped vehicle (notice)" },
              { "$": "option", "name": "slow", "label": "Slow traffic (notice)" },
              { "$": "option", "name": "works", "label": "Works (notice)" },
              { "$": "option", "name": "closure", "label": "Closure (notice)" },
              { "$": "option", "name": "rain", "label": "Rain (notice)" },
              { "$": "option", "name": "fog", "label": "Fog (notice)" },
              { "$": "option", "name": "debris", "label": "Debris (notice)" },
              { "$": "option", "name": "event", "label": "Event (notice)" }
            ] },
          { "$": "field", "name": "a_text", "$type": "string", "label": "Message", "hint": "the lower car park floods at high tide", "max": 120 },
          { "$": "field", "name": "a_for", "$type": "enum", "label": "For", "default": "1d",
            "children": [
              { "$": "option", "name": "1d", "label": "1 day" },
              { "$": "option", "name": "2d", "label": "2 days" },
              { "$": "option", "name": "1w", "label": "1 week" },
              { "$": "option", "name": "1m", "label": "1 month" },
              { "$": "option", "name": "6m", "label": "6 months" },
              { "$": "option", "name": "1y", "label": "1 year" }
            ] },
          { "$": "field", "name": "a_here", "$type": "bool", "label": "Mark where I am", "default": false,
            "tip": "Adds this phone's position, so others see where it is." },
          { "$": "field", "name": "a_rad", "$type": "enum", "label": "Area around it", "default": "spot",
            "children": [
              { "$": "option", "name": "spot", "label": "Just the spot" },
              { "$": "option", "name": "100m", "label": "100 m" },
              { "$": "option", "name": "500m", "label": "500 m" },
              { "$": "option", "name": "1km", "label": "1 km" },
              { "$": "option", "name": "5km", "label": "5 km" }
            ] }
        ]
      },
      { "$": "action", "name": "post", "label": "Post", "style": "primary", "icon": "campaign",
        "confirm": true, "confirm-label": "Post this alert?",
        "confirm-text": "Everybody nearby sees it, and a station you own keeps it until it ends or you withdraw it." },
      { "$": "field", "name": "post_now", "$type": "details", "empty": "" }
    ]
  },
  {
    "$": "screen",
    "name": "Alert",
    "icon": "campaign",
    "hidden": true,
    "children": [
      { "$": "field", "name": "alert_now", "$type": "details", "empty": "" },
      { "$": "action", "name": "withdraw", "label": "Withdraw", "style": "danger", "icon": "delete",
        "confirm": true, "confirm-label": "Withdraw this alert?",
        "confirm-text": "Everybody nearby is told it is over, and your stations stop giving it." },
      { "$": "action", "name": "back", "label": "Back", "icon": "close" }
    ]
  }
]
