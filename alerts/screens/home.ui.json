[
  {
    "$": "screen",
    "name": "Nearby",
    "icon": "radar",
    "children": [
      {
        "$": "field",
        "name": "alerts",
        "$type": "people",
        "empty_art": "media/art/clear.svg",
        "empty_title": "All clear here",
        "empty": "Nobody nearby has posted a warning or a notice.\n\nWhen somebody does, it shows up here and you are told, even with the app closed. A station keeps its owner's alerts and gives them to everybody who arrives, so you hear about them when you get there.\n\nTo post one yourself, tap + at the top."
      }
    ]
  },
  {
    "$": "screen",
    "name": "New alert",
    "icon": "add",
    "menu": true,
    "appbar": true,
    "children": [
      {
        "$": "field",
        "name": "p_type",
        "$type": "stats"
      }
    ]
  },
  {
    "$": "screen",
    "name": "Kind",
    "icon": "category",
    "hidden": true,
    "children": [
      {
        "$": "field",
        "name": "p_kind",
        "$type": "stats"
      },
      {
        "$": "action",
        "name": "p_back",
        "label": "Back"
      }
    ]
  },
  {
    "$": "screen",
    "name": "Severity",
    "icon": "category",
    "hidden": true,
    "children": [
      {
        "$": "field",
        "name": "p_sev",
        "$type": "stats"
      },
      {
        "$": "action",
        "name": "p_back",
        "label": "Back"
      }
    ]
  },
  {
    "$": "screen",
    "name": "Message",
    "icon": "description",
    "hidden": true,
    "tip": "A few words people need to know. What, how bad and how long are already on the alert.",
    "children": [
      {
        "$": "field",
        "name": "a_text",
        "$type": "string",
        "label": "Message",
        "hint": "the lower car park floods at high tide",
        "max": 70
      },
      {
        "$": "action",
        "name": "p_next",
        "label": "Next",
        "style": "primary",
        "icon": "check"
      },
      {
        "$": "action",
        "name": "p_back",
        "label": "Back"
      }
    ]
  },
  {
    "$": "screen",
    "name": "Duration",
    "icon": "schedule",
    "hidden": true,
    "children": [
      {
        "$": "field",
        "name": "p_for",
        "$type": "stats"
      },
      {
        "$": "action",
        "name": "p_back",
        "label": "Back"
      }
    ]
  },
  {
    "$": "screen",
    "name": "Place",
    "icon": "map",
    "hidden": true,
    "children": [
      {
        "$": "field",
        "name": "p_where",
        "$type": "stats"
      },
      {
        "$": "action",
        "name": "p_back",
        "label": "Back"
      }
    ]
  },
  {
    "$": "screen",
    "name": "Review",
    "icon": "visibility",
    "hidden": true,
    "tip": "Tap a tile to change it.",
    "children": [
      {
        "$": "field",
        "name": "p_msg",
        "$type": "details",
        "empty": ""
      },
      {
        "$": "field",
        "name": "p_review",
        "$type": "stats"
      },
      {
        "$": "action",
        "name": "post",
        "label": "Post alert",
        "style": "primary",
        "icon": "campaign"
      },
      {
        "$": "action",
        "name": "save",
        "label": "Save edit",
        "style": "primary",
        "icon": "save"
      },
      {
        "$": "action",
        "name": "p_back",
        "label": "Back"
      }
    ]
  },
  {
    "$": "screen",
    "name": "Alert",
    "icon": "info",
    "hidden": true,
    "children": [
      {
        "$": "field",
        "name": "a_msg",
        "$type": "details",
        "empty": ""
      },
      {
        "$": "field",
        "name": "a_hub",
        "$type": "stats"
      },
      {
        "$": "action",
        "name": "edit",
        "label": "Edit",
        "icon": "edit"
      },
      {
        "$": "action",
        "name": "history",
        "label": "Edit history",
        "icon": "history"
      },
      {
        "$": "action",
        "name": "withdraw",
        "label": "Withdraw",
        "style": "danger",
        "icon": "delete",
        "confirm": true,
        "confirm-label": "Withdraw this alert?",
        "confirm-text": "Everybody nearby is told it is over, and your stations stop giving it."
      }
    ]
  },
  {
    "$": "screen",
    "name": "History",
    "icon": "history",
    "hidden": true,
    "children": [
      {
        "$": "field",
        "name": "a_hist",
        "$type": "details",
        "empty": ""
      }
    ]
  }
]
