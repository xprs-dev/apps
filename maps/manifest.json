{
  "id":              "tools.xprs.maps",
  "version":         "1.0.3",
  "kind":            "app",
  "title":           "Maps",
  "description":     "Satellite maps that also work offline.",
  "summary":         "Browse satellite images and zoom in anywhere. Tiles are saved on the device. Places you already visited stay available without a network.",
  "icon":            "media/icons/map.svg",
  "tags":            ["maps", "satellite", "gps", "tools"],
  "entry_ui":        "screens/home.ui.json",
  "tick_interval_ms": 1000,
  "permissions":     ["network", "storage"],
  "provides": {
    "functions": [],
    "events":    ["viewport.changed"],
    "variables": ["center_lat", "center_lon", "zoom"]
  },
  "requires": {
    "hal":       ["log", "kv", "msg", "platform"],
    "events":    [],
    "libraries": [],
    "variables": []
  }
}
