[
  {
    "$": "screen",
    "name": "@screen.activity",
    "icon": "home",
    "tip": "@screen.activity_tip",
    "children": [
      {
        "$": "field",
        "name": "activity",
        "$type": "chat",
        "hint": "@field.activity_hint"
      },
      {
        "$": "action",
        "name": "clear_feed",
        "label": "@action.clear_feed",
        "icon": "delete",
        "slot": "menu",
        "tip": "@action.clear_feed_tip"
      }
    ]
  },
  {
    "$": "screen",
    "name": "@screen.search",
    "icon": "search",
    "menu": true,
    "appbar": true,
    "tip": "@screen.search_tip",
    "children": [
      {
        "$": "field",
        "name": "search_input",
        "$type": "string",
        "label": "@field.search",
        "hint": "@field.search_hint",
        "live": true
      },
      {
        "$": "field",
        "name": "search_kind",
        "$type": "enum",
        "label": "@field.find",
        "default": "all",
        "apply": "search_kind_changed",
        "children": [
          {
            "$": "option",
            "name": "all",
            "label": "@option.everything"
          },
          {
            "$": "option",
            "name": "posts",
            "label": "@option.posts"
          },
          {
            "$": "option",
            "name": "people",
            "label": "@option.people"
          }
        ]
      },
      {
        "$": "field",
        "name": "search_when",
        "$type": "enum",
        "label": "@field.when",
        "default": "any",
        "apply": "search_when_changed",
        "children": [
          {
            "$": "option",
            "name": "any",
            "label": "@option.any_time"
          },
          {
            "$": "option",
            "name": "day",
            "label": "@option.day"
          },
          {
            "$": "option",
            "name": "week",
            "label": "@option.week"
          },
          {
            "$": "option",
            "name": "month",
            "label": "@option.month"
          }
        ]
      },
      {
        "$": "field",
        "name": "search_results",
        "$type": "chat"
      }
    ]
  },
  {
    "$": "screen",
    "name": "@screen.following",
    "icon": "people",
    "menu": true,
    "tip": "@screen.following_tip",
    "children": [
      {
        "$": "action",
        "name": "follow_add",
        "label": "@action.follow_add",
        "icon": "person_add",
        "style": "primary",
        "tip": "@action.follow_add_tip"
      },
      {
        "$": "field",
        "name": "follow_input",
        "$type": "string",
        "label": "@field.callsign",
        "hint": "X1ABCD"
      },
      {
        "$": "field",
        "name": "follows_list",
        "$type": "people",
        "tip": "@field.follows_list_tip"
      }
    ],
    "toolbar": true
  }
]
